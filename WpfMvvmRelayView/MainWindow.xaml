<Window x:Class="WpfMvvmRelayView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfMvvmRelayView.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    
    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <!--Buttons-->
        <Grid Grid.Column="0">
            <StackPanel>
                <!--Getting style from static resources-->
                <Button 
                    Content="View 1"
                    Margin="10"
                    Style="{StaticResource GoldenBtn}"
                    Command="{Binding View1Command}"/>
                
                <!--Getting style from static resources-->
                <Button 
                    Content="View 2"
                    Margin="10"
                    Style="{StaticResource ForestBtn}"
                    Command="{Binding View2Command}"/>
                
                <!--Manual Styling. We don't want this!-->
                <Button 
                    Content="View 3"
                    Margin="10"
                    Background="Red"
                    Command="{Binding View3Command}"/>
            </StackPanel>
        </Grid>
        
        <!--Grid Splitter-->
        <GridSplitter Grid.Column="1" Background="Black" Width="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!--View-->
        <Grid Grid.Column="2">
            <ContentControl
                Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
