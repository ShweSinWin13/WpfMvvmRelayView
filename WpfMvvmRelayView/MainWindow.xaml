        xmlns:vm="clr-namespace:WpfMvvmRelayView.ViewModel"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    
    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>
    
    <Border CornerRadius="30" Background="#EFF2F7" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Menu Buttons -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Button Style="{StaticResource topButton}" HorizontalAlignment="Left" Margin="20 28 0 35">
                    <icon:PackIconMaterial Kind="Menu" Width="15"/>
                </Button>
                
                <Border Grid.Row="1" Background="#623ED0" CornerRadius="0 25 0 30">
                    <DockPanel>
                        <!-- Menu Buttons -->
                        <StackPanel DockPanel.Dock="Top">
                            <!-- <Button Style="{StaticResource menuButton}" -->
                            <!--         Content="View 1" -->
                            <!--         Margin="10" -->
                            <!--         Command="{Binding View1Command}"> -->
                            <!--      -->
                            <!-- </Button> -->
                            
                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 1"></TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="BookEdit" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 2"></TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="Account" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 3"></TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="File" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 4"></TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            
                <!--Grid Splitter-->
                <GridSplitter Grid.Column="1" Background="Black" Width="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            
                <!--View-->
                <Grid Grid.Column="2">
                    <ContentControl
                        Content="{Binding CurrentView}"/>
                </Grid>
        </Grid>
    </Border>
