<Window x:Class="WpfMvvmRelayView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfMvvmRelayView.ViewModel"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MainWindow" Height="350" Width="800">

    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>

    <Border CornerRadius="30" Background="#EFF2F7" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/> <!-- column 0 -->
                <ColumnDefinition Width="*"/>   <!-- column 1 -->
            </Grid.ColumnDefinitions>

            <!-- Left Menu -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Style="{StaticResource topButton}" HorizontalAlignment="Left" Margin="20 28 0 35">
                    <icon:PackIconMaterial Kind="Menu" Width="15"/>
                </Button>

                <Border Grid.Row="1" Background="#623ED0" CornerRadius="0 25 0 30">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource menuButton}" Command="{Binding View1Command}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 1"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Command="{Binding View2Command}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="BookEdit" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 2"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Command="{Binding View3Command}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="Account" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 3"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Command="{Binding View4Command}">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="File" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="View 4"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Optional: a thin splitter between columns -->
            <GridSplitter Grid.Column="0" HorizontalAlignment="Right" Width="4" Background="Transparent" VerticalAlignment="Stretch"/>

            <!-- CONTENT: put in column 1 (second column) -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
