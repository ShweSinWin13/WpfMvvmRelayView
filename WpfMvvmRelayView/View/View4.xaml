<UserControl x:Class="WpfMvvmRelayView.View.View4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfMvvmRelayView.View"
             xmlns:vm="clr-namespace:WpfMvvmRelayView.ViewModel"
             xmlns:converter="clr-namespace:PosDesktopApplication.View.ValCon"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Background="Blue">
    <UserControl.DataContext>
        <vm:View4VM/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converter:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Grid Row="0">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="View 4 (TreeView)"/>
        </Grid>
        
        <Grid Row="1">
            <Menu>
                <MenuItem
                    Header="File (Menu)">
                    <MenuItem
                        Header="Add"
                        Command="{Binding AddCmd}"
                        CommandParameter="{x:Reference treeView}"/>
                    <MenuItem
                        Header="Edit"
                        Command="{Binding EditCmd}"
                        CommandParameter="{x:Reference treeView}"/>
                    <MenuItem
                        Header="Delete"
                        Command="{Binding DeleteCmd}"
                        CommandParameter="{x:Reference treeView}"/>
                </MenuItem>
            </Menu>
        </Grid>
        
        <Grid Row="2">
            <TreeView
                x:Name="treeView"
                ItemsSource="{Binding TreeItems}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock
                                Text="{Binding Code}"
                                Visibility="{Binding IsCodeFirstPath, 
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <!--⤳⚡✦-->
                            <TextBlock
                                Text=" ⤳ "
                                Visibility="{Binding IsCodeFirstPath, 
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <TextBox 
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Visibility="{Binding IsEditing, 
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                LostFocus="TextBox_LostFocus"/>
                            <TextBlock
                                Text="{Binding Name}" 
                                Visibility="{Binding IsEditing, 
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <!--<TextBlock Text="{Binding Code}" Visibility="Hidden" Width="1"/>-->
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                
                <TreeView.InputBindings>
                    <KeyBinding 
                        Modifiers="Control" Key="Insert" 
                        Command="{Binding CtrlInsertShortcutTreeView}"
                        CommandParameter="{x:Reference treeView}"/>
                    <KeyBinding 
                        Key="Space" 
                        Command="{Binding SpaceShortcutTreeView}"
                        CommandParameter="{x:Reference treeView}"/>
                    <KeyBinding 
                        Key="Enter" 
                        Command="{Binding PressEnterShortcutTreeView}"
                        CommandParameter="{x:Reference treeView}"/>
                    <KeyBinding 
                        Key="Delete" 
                        Command="{Binding DeleteShortcutTreeView}"
                        CommandParameter="{x:Reference treeView}"/>
                </TreeView.InputBindings>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
